{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=:path*"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,tests/**,docs/**,scripts/**,migrations/**,data/**,output/**,tmp/**,agro-pipeline/**,Desafio-Nasa/**}",
      "maxDuration": 30
    }
  }
}
