# Copiar para .env. Não publicar este arquivo.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Opcional: armazenamento Supabase Storage, bucket PRIVADO criado previamente.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=agro-rasters
# Acesso NASA PPS para arquivos IMERG Final Run GIS (cadastro separado do Earthdata)
PPS_USERNAME=
PPS_PASSWORD=
POWER_BASE=https://power.larc.nasa.gov/api/temporal/daily/point
DATA_DIR=/app/data
